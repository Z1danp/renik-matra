generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ==========================================
// ENUMS (RBAC, STATUS PESANAN, & PEMBAYARAN)
// ==========================================

enum UserRole {
  BUYER
  ADMIN
}

enum OrderStatus {
  PENDING_PAYMENT
  PAID
  PROCESSING
  SHIPPED
  COMPLETED
  CANCELLED
  EXPIRED
}

enum PaymentStatus {
  PENDING
  SETTLEMENT
  EXPIRED
  CANCELLED
  FAILED
}

// ==========================================
// MODUL 1: KATALOG PRODUK (3NF SUBTYPE PATTERN)
// ==========================================

model Category {
  id       Int       @id @default(autoincrement())
  name     String    @unique @db.VarChar(50)
  slug     String    @unique @db.VarChar(50)
  products Product[]

  @@map("categories")
}

model Product {
  id          String   @id @default(uuid()) @db.Uuid
  categoryId  Int      @map("category_id")
  name        String   @db.VarChar(255)
  slug        String   @unique @db.VarChar(255)
  brand       String   @db.VarChar(100)
  description String?  @db.Text
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz

  category Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  // Subtype 1:1 Relations
  chemicalAttribute       ChemicalAttribute?
  glasswareAttribute      GlasswareAttribute?
  instrumentPartAttribute InstrumentPartAttribute?

  variants ProductVariant[]

  @@map("products")
}

model ChemicalAttribute {
  productId String  @id @map("product_id") @db.Uuid
  casNumber String  @unique @map("cas_number") @db.VarChar(20)
  iupacName String? @map("iupac_name") @db.VarChar(255)
  formula   String? @db.VarChar(100)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  productGhsHazards ProductGhsHazard[]

  @@map("chemical_attributes")
}

model GlasswareAttribute {
  productId       String   @id @map("product_id") @db.Uuid
  material        String   @db.VarChar(100)
  glassClass      String?  @map("glass_class") @db.VarChar(20)
  isAutoclavable Boolean? @default(true) @map("is_autoclavable")

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("glassware_attributes")
}

model InstrumentPartAttribute {
  productId      String  @id @map("product_id") @db.Uuid
  instrumentType String  @map("instrument_type") @db.VarChar(100)
  oemPartNumber  String? @map("oem_part_number") @db.VarChar(100)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("instrument_part_attributes")
}

model GhsHazard {
  id   Int    @id @default(autoincrement())
  code String @unique @db.VarChar(10)
  name String @db.VarChar(100)

  productGhsHazards ProductGhsHazard[]

  @@map("ghs_hazards")
}

model ProductGhsHazard {
  productId   String @map("product_id") @db.Uuid
  ghsHazardId Int    @map("ghs_hazard_id")

  chemicalAttribute ChemicalAttribute @relation(fields: [productId], references: [productId], onDelete: Cascade)
  ghsHazard         GhsHazard         @relation(fields: [ghsHazardId], references: [id], onDelete: Cascade)

  @@id([productId, ghsHazardId])
  @@map("product_ghs_hazards")
}

model ProductVariant {
  id            String   @id @default(uuid()) @db.Uuid
  productId     String   @map("product_id") @db.Uuid
  sku           String   @unique @db.VarChar(100)
  grade         String?  @db.VarChar(50)
  packagingSize Decimal? @map("packaging_size") @db.Decimal(10, 2)
  unit          String?  @db.VarChar(20)
  price         BigInt
  stock         Int      @default(0)
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz

  product    Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  cartItems  CartItem[]
  orderItems OrderItem[]

  @@map("product_variants")
}

// ==========================================
// MODUL 2: PENGGUNA & ALAMAT (AUTH & RBAC)
// ==========================================

model User {
  id           String   @id @default(uuid()) @db.Uuid
  email        String   @unique @db.VarChar(255)
  passwordHash String   @map("password_hash") @db.VarChar(255)
  fullName     String   @map("full_name") @db.VarChar(255)
  phoneNumber  String?  @map("phone_number") @db.VarChar(50)
  role         UserRole @default(BUYER)
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  addresses UserAddress[]
  cart      Cart?
  orders    Order[]

  @@index([email])
  @@map("users")
}

model UserAddress {
  id              String   @id @default(uuid()) @db.Uuid
  userId          String   @map("user_id") @db.Uuid
  label           String   @default("Utama") @db.VarChar(50)
  recipientName   String   @map("recipient_name") @db.VarChar(255)
  recipientPhone  String   @map("recipient_phone") @db.VarChar(50)
  institutionName String?  @map("institution_name") @db.VarChar(255)
  fullAddress     String   @map("full_address") @db.Text
  city            String   @db.VarChar(100)
  province        String   @db.VarChar(100)
  postalCode      String   @map("postal_code") @db.VarChar(20)
  isPrimary       Boolean  @default(false) @map("is_primary")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("user_addresses")
}

// ==========================================
// MODUL 3: KERANJANG BELANJA (CART SUBSYSTEM)
// ==========================================

model Cart {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @unique @map("user_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  user  User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items CartItem[]

  @@map("carts")
}

model CartItem {
  id               String   @id @default(uuid()) @db.Uuid
  cartId           String   @map("cart_id") @db.Uuid
  productVariantId String   @map("product_variant_id") @db.Uuid
  quantity         Int
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  cart           Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade)
  productVariant ProductVariant @relation(fields: [productVariantId], references: [id], onDelete: Cascade)

  @@unique([cartId, productVariantId])
  @@map("cart_items")
}

// ==========================================
// MODUL 4: TRANSAKSI & PEMBAYARAN (ORDER SUBSYSTEM)
// ==========================================

model Order {
  id          String      @id @default(uuid()) @db.Uuid
  orderNumber String      @unique @map("order_number") @db.VarChar(50)
  userId      String      @map("user_id") @db.Uuid
  status      OrderStatus @default(PENDING_PAYMENT)
  totalAmount BigInt      @map("total_amount")

  // Snapshot Alamat Pengiriman
  shippingRecipientName   String  @map("shipping_recipient_name") @db.VarChar(255)
  shippingRecipientPhone  String  @map("shipping_recipient_phone") @db.VarChar(50)
  shippingInstitutionName String? @map("shipping_institution_name") @db.VarChar(255)
  shippingFullAddress     String  @map("shipping_full_address") @db.Text
  shippingCity            String  @map("shipping_city") @db.VarChar(100)
  shippingProvince        String  @map("shipping_province") @db.VarChar(100)
  shippingPostalCode      String  @map("shipping_postal_code") @db.VarChar(20)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  user    User        @relation(fields: [userId], references: [id], onDelete: Restrict)
  items   OrderItem[]
  payment Payment?

  @@index([userId])
  @@index([status])
  @@map("orders")
}

model OrderItem {
  id               String  @id @default(uuid()) @db.Uuid
  orderId          String  @map("order_id") @db.Uuid
  productVariantId String? @map("product_variant_id") @db.Uuid

  // Snapshot Detail Produk saat Dibeli
  productName     String @map("product_name") @db.VarChar(255)
  variantSku      String @map("variant_sku") @db.VarChar(100)
  variantDetails  String @map("variant_details") @db.VarChar(255)
  priceAtPurchase BigInt @map("price_at_purchase")
  quantity        Int
  subtotal        BigInt

  order          Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productVariant ProductVariant? @relation(fields: [productVariantId], references: [id], onDelete: SetNull)

  @@map("order_items")
}

model Payment {
  id                   String        @id @default(uuid()) @db.Uuid
  orderId              String        @unique @map("order_id") @db.Uuid
  gatewayTransactionId String?       @map("gateway_transaction_id") @db.VarChar(255)
  paymentType          String?       @map("payment_type") @db.VarChar(50)
  amount               BigInt
  status               PaymentStatus @default(PENDING)
  rawResponse          Json?         @map("raw_response")
  paidAt               DateTime?     @map("paid_at") @db.Timestamptz
  createdAt            DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt            DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@map("payments")
}